# Copy to .env (gitignored) for local Ask Prash testing. Never commit real keys.

# Anthropic API key from the "ask-prash" workspace, which has its own spend limit.
ANTHROPIC_API_KEY=

# Kill switch for /api/ask-prash. Anything other than "true" turns the bot off.
ASK_PRASH_ENABLED=true

# Makes the page call the real endpoint instead of canned replies. Build-time.
PUBLIC_ASK_PRASH_LIVE=true
