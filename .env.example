# Copy to .env (gitignored) for local Ask Prash testing. Never commit real keys.

# Anthropic API key from the "ask-prash" workspace, which has its own spend limit.
ANTHROPIC_API_KEY=

# Kill switch for /api/ask-prash. Anything other than "true" turns the bot off.
ASK_PRASH_ENABLED=true

# Makes the page call the real endpoint instead of canned replies. Build-time.
PUBLIC_ASK_PRASH_LIVE=true

# Signs sessions and replies, and keys the IP hashes. 32+ random characters:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
ASK_PRASH_SECRET=

# Cloudflare Turnstile. These are Cloudflare's public test keys, which always
# pass; production uses the real pair from the Cloudflare dashboard.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Spending caps in USD. The bot rests once either is reached.
ASK_PRASH_DAILY_CAP_USD=0.83
ASK_PRASH_MONTHLY_CAP_USD=25

# Optional. A URL that gets a plain-text POST when a cap is hit, such as
# https://ntfy.sh/<a-long-random-topic> to get a phone notification.
ASK_PRASH_ALERT_URL=
